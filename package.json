{
  "name": "colophon",
  "private": false,
  "version": "0.1.5",
  "description": "Free self-hostable publishing software for independent publications, collectives, archives, podcasts, campaigns and print work.",
  "author": {
    "name": "Colophon contributors"
  },
  "desktopName": "Colophon",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "vite --mode browser-local",
    "prebuild": "node scripts/prepare-flite-tts-assets.mjs",
    "build": "vite build",
    "build:pwa": "vite build --mode browser-local --outDir dist-pwa",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run build:pwa",
    "preview": "vite preview",
    "preview:pwa": "vite preview --outDir dist-pwa",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "segmentation:dev": "cd services/printlab-segmentation && uvicorn app:app --reload --port 8000",
    "desktop": "npm run build && electron .",
    "desktop:dev": "npm run build && electron . --dev",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64",
    "desktop:dist:mac": "npm run build && electron-builder --mac",
    "desktop:dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fast-xml-parser": "^4.5.0",
    "openpgp": "^6.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "org.colophon.desktop",
    "productName": "Colophon",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "functions/**/*",
      "db/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Colophon-${version}-Windows-${arch}.${ext}",
      "icon": "public/colophon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "public/colophon-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Colophon-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/colophon-icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Colophon-${version}-Linux-${arch}.${ext}"
    }
  }
}
