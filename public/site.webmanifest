{
  "name": "Colophon",
  "short_name": "Colophon",
  "description": "Free local-first publishing software for independent publications, archives, podcasts, campaigns and print work.",
  "start_url": "./#/welcome",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f6f4",
  "theme_color": "#1c1e21",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "application/pdf",
            "text/plain",
            "text/markdown"
          ]
        }
      ]
    }
  }
}
